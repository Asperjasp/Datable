# Copy this to .env and fill in your keys
# Never commit .env to git

# ── US Cloud LLM providers ──────────────────────────────────────────────
# Optional - skip if budget constrained
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# ── OpenRouter (Regional models proxy) ───────────────────────────────────
# Access to: Qwen (China), DeepSeek (China), Ling (Ant Group), Baichuan
# Also: Mistral (Europe), Llama (Open source), hundreds more
OPENROUTER_API_KEY=sk-or-...

# ── China Direct (Cross-Provider Consistency Check) ─────────────────────
# Run same model via both Dashscope AND OpenRouter to measure
# provider-level effects on response consistency.
# See paper/methodology.md for full methodology.
DASHSCOPE_API_KEY=sk-...

# ── Europe (Mistral AI) ───────────────────────────────────────────────────
# French model for regional comparison
MISTRAL_API_KEY=...

# ── Latin America / Open Source (HuggingFace) ───────────────────────────
# Free tier available for Llama 3.1 and other open models.
# LATAM GPT note: latam-gpt org on HF currently only has Wayra-Perplexity-
# Estimator-55M (classification model, not chat LLM). Use Llama 3.1 as 
# the de facto LATAM proxy until LATAM GPT releases their foundation model.
HUGGINGFACE_API_KEY=hf_...

# ── Local Gemma via Ollama (sovereignty comparison) ──────────────────────
# No API key needed - runs on your local hardware
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
OLLAMA_MODEL_GEMMA4=gemma4:12b
